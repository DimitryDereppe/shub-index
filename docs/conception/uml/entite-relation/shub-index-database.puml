' Diagramme entité-relation — reflet du MPD (merise/mpd.sql)
@startuml base-de-donnees-shub-index
hide circle
skinparam linetype ortho

entity "user" as user {
  *id : INT <<PK>>
  --
  *email : VARCHAR(128) <<unique>>
  *firstname : VARCHAR(128)
  *lastname : VARCHAR(128)
  *password : VARCHAR(256)
  *role : role
  created_at / updated_at
}

entity "refresh_token" as rt {
  *id : INT <<PK>>
  --
  *token_hash : VARCHAR(128) <<unique>>
  *consumed : BOOLEAN
  *user_id : INT <<FK>>
  issued_at / expires_at
}

entity "scan" as scan {
  *id : INT <<PK>>
  --
  *started_at : TIMESTAMPTZ
  finished_at : TIMESTAMPTZ
  *status : scan_status
  files_added / files_updated / files_removed : INT
  error_message : TEXT
  user_id : INT <<FK>>
}

entity "media_file" as mf {
  *id : INT <<PK>>
  --
  *path : TEXT <<unique>>
  *filename : VARCHAR(255)
  *extension : VARCHAR(10)
  *size_bytes : BIGINT
  *modified_at : TIMESTAMPTZ
  *status : media_file_status
  *last_seen_at : TIMESTAMPTZ
  movie_id : INT <<FK>>
}

entity "movie" as movie {
  *id : INT <<PK>>
  --
  *title : VARCHAR(255)
  original_title : VARCHAR(255)
  release_year : SMALLINT
  runtime : SMALLINT
  synopsis : TEXT
  poster_url : VARCHAR(512)
  tmdb_id : INT <<unique>>
}

entity "genre" as genre {
  *id : INT <<PK>>
  --
  *name : VARCHAR(64) <<unique>>
  tmdb_id : INT <<unique>>
}

entity "person" as person {
  *id : INT <<PK>>
  --
  *name : VARCHAR(255)
  tmdb_id : INT <<unique>>
}

entity "movie_has_genre" as mhg {
  *movie_id : INT <<PK, FK>>
  *genre_id : INT <<PK, FK>>
}

entity "movie_director" as md {
  *movie_id : INT <<PK, FK>>
  *person_id : INT <<PK, FK>>
}

entity "movie_cast" as mc {
  *movie_id : INT <<PK, FK>>
  *person_id : INT <<PK, FK>>
  --
  character_name : VARCHAR(255)
  cast_order : SMALLINT
}

user ||--o{ rt
user |o--o{ scan
movie |o--o{ mf
movie ||--o{ mhg
genre ||--o{ mhg
movie ||--o{ md
person ||--o{ md
movie ||--o{ mc
person ||--o{ mc
@enduml
