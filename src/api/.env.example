# Configuration de l'API pour un lancement SANS Docker (npm run dev / scan:dev).
DATABASE_URL="postgresql://shubindex:shubindex@localhost:5432/shubindex"
PORT=4000

# Authentification par cookies httpOnly + JWT (cf. src/lib/tokens.ts).
JWT_SECRET=change-moi-en-un-secret-long-et-aleatoire
ALLOWED_ORIGINS=http://localhost:5173
# vide : pas de proxy de confiance (le proxy de Vite est sur la même machine : req.ip = 127.0.0.1)
TRUST_PROXY=

# TMDB (secret)
TMDB_TOKEN=
CAST_LIMIT=15

# Partage réseau (chemin réel sur la machine qui lance l'API)
SHARE_ROOT=/mnt/nas/Shub-Niggurath
SCAN_ROOTS=Films,Animé
SCAN_EXCLUDED=Séries,Extras,Golden Collection,_À trier
SHARE_UNC_PREFIX='\\<ip-du-nas>\Shub-Niggurath'
PLAY_URL_PREFIX=smb://<ip-du-nas>/Shub-Niggurath
LAN_CIDRS=192.168.1.0/24,127.0.0.1/32,::1/128
AUTH_RATE_LIMIT=10
EMAIL_RATE_LIMIT=5
# Emails « mot de passe oublié » : Mailpit en développement (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="shub-index <no-reply@localhost>"
APP_URL=http://localhost:5173
