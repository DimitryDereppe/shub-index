# Variables des tests d'intégration (npm run test:spec). Aucune valeur secrète :
# la base est un conteneur jetable créé puis supprimé par global-setup.ts.
PORT=4100
POSTGRES_USER=shubtest
POSTGRES_PASSWORD=shubtest
POSTGRES_DB=shubtest
POSTGRES_PORT=5499
DATABASE_URL=postgresql://shubtest:shubtest@localhost:5499/shubtest
JWT_SECRET=secret-de-test-uniquement
ALLOWED_ORIGINS=http://localhost:4100
TRUST_PROXY=
TMDB_TOKEN=
# lecture VLC : le serveur de test est appelé depuis la machine elle-même → "réseau local"
PLAY_URL_PREFIX=smb://nas-de-test/Partage
LAN_CIDRS=127.0.0.1/32,::1/128
# tous les tests viennent de la même IP : limite haute (le test dédié l'abaisse le temps d'un test)
AUTH_RATE_LIMIT=1000
