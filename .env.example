# Variables lues par docker-compose.yml : copier en ".env" (jamais commité), puis adapter.

# ---- Base de données ----
POSTGRES_USER=shubindex
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=shubindex
DB_PORT=5432          # port publié sur 127.0.0.1 (pour npm run dev / psql) — ignoré sur aldebaran
CLIENT_PORT=8080      # http://localhost:8080 en local — ignoré sur aldebaran

# ---- Authentification ----
JWT_SECRET=change-moi-en-un-secret-long-et-aleatoire
ALLOWED_ORIGINS=      # inutile : client et API sont sur la même origine

# ---- Reverse proxy ----
# Adresse ou plage du SEUL proxy dont on croit l'en-tête X-Forwarded-For (jamais "true").
# Local : le réseau Docker du projet (sous-réseau fixé dans docker-compose.yml).
# aldebaran : réseau de Caddy (bookstack_default), ex. 172.19.0.0/16.
TRUST_PROXY=172.28.50.0/24

# ---- TMDB ----
TMDB_TOKEN=           # jeton "lecture" (API Read Access Token) — secret
CAST_LIMIT=15

# ---- Partage réseau ----
# NAS (kinginyellow) monté en NFS par Docker : IP (pas le nom : c'est le noyau qui monte) + chemin exporté
NAS_ADDRESS=192.168.1.37
NAS_SHARE_PATH=/srv/nas/Shub-Niggurath
SCAN_ROOTS=Films,Animé
SCAN_EXCLUDED=Séries,Extras,Golden Collection,_À trier
SHARE_UNC_PREFIX='\\<ip-du-nas>\Shub-Niggurath'   # chemin affiché sur la fiche film
PLAY_URL_PREFIX=smb://<ip-du-nas>/Shub-Niggurath  # début des URL écrites dans les .m3u
# "réseau local" pour la lecture VLC. En local, ajouter 172.28.50.1/32 : c'est l'adresse sous
# laquelle Docker présente les requêtes de la machine hôte (http://localhost). Sans risque car le
# client n'écoute que sur 127.0.0.1. Ne JAMAIS l'ajouter sur aldebaran.
LAN_CIDRS=192.168.1.0/24
# Nom DuckDNS de la box : depuis le réseau local, un appareil qui ouvre le site par ce nom revient
# avec l'IP PUBLIQUE de la box (hairpin NAT) → cette IP compte aussi comme locale. Vide = désactivé.
LAN_PUBLIC_HOSTNAME=owikiclock.duckdns.org
AUTH_RATE_LIMIT=10    # mots de passe faux tolérés par IP et par 15 min (connexion, inscription…) ; au-delà : 429
EMAIL_RATE_LIMIT=5    # demandes « mot de passe oublié » par IP et par 15 min

# Emails « mot de passe oublié » (Nodemailer). SMTP_HOST vide = aucun email envoyé.
# Gmail : smtp.gmail.com, port 465, SMTP_SECURE=true, SMTP_USER = l'adresse Gmail,
# SMTP_PASS = un « mot de passe d'application » Google (jamais le vrai mot de passe) — secret.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="shub-index <adresse-gmail@gmail.com>"
APP_URL=http://localhost:8080   # adresse du site, utilisée dans le lien de l'email (https://… en production)
